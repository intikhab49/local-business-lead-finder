# Provider Selection: google_places | osm | foursquare | geoapify
PROVIDER_NAME=google_places

# Free/open-data fallback used when the primary provider errors, is
# rate-limited, or has nothing for an area. Set to "none" to disable.
FALLBACK_PROVIDER_NAME=osm

# Google Places API Configuration (New v1)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT=30
GOOGLE_PLACES_MAX_RESULTS=500

# Foursquare API Configuration (optional, only if PROVIDER_NAME=foursquare)
FOURSQUARE_API_KEY=your_api_key_here
FOURSQUARE_BASE_URL=https://places-api.foursquare.com/places
FOURSQUARE_TIMEOUT=30
FOURSQUARE_MAX_RESULTS=20

# Application Settings
APP_NAME=Business Lead Finder
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_PREFIX=/api/v1
DEFAULT_RADIUS=5000
MAX_RESULTS=20
PROVIDER_TIMEOUT=30

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenStreetMap / Overpass (free, no API key required)
OSM_TIMEOUT=90
OSM_MAX_RESULTS=500
# Overpass asks for one heavy query at a time per client — seconds between calls
OSM_MIN_INTERVAL=1.5
# Both Overpass and Nominatim require a descriptive User-Agent
OSM_USER_AGENT=BusinessLeadFinder/2.1 (self-hosted lead research tool)

# Discovery engine (grid crawl)
# Grid cells searched at once
DISCOVERY_CONCURRENCY=4
# Adaptive pacing: starts at MIN, doubles on 429/5xx up to MAX, recovers on
# a clean streak. Replaces the old fixed pause between batches.
DISCOVERY_MIN_INTERVAL=0.35
DISCOVERY_MAX_INTERVAL=30
DISCOVERY_BACKOFF_FACTOR=2.0
DISCOVERY_RECOVERY_FACTOR=0.75
DISCOVERY_RECOVERY_STREAK=3
# How long a finished job stays pollable (seconds)
DISCOVERY_JOB_TTL=3600

# Website scraping during a discovery run
ENRICHMENT_CONCURRENCY=20
